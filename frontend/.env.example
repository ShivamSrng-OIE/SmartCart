# Copy to frontend/.env.local to override settings on one machine. Every value is optional:
# in development Vite forwards /api, /media, /health and /shop-mcp to the backend on localhost:8000.

# Address of the backend when it runs on another host (set at build time, no trailing slash).
# VITE_API_URL=https://tote-api-wbpx.onrender.com

# The two AI shoppers. Both default to the shared /api/run route with a different `mode` field.
# VITE_UNPROTECTED_RUN_URL=/api/run
# VITE_UNPROTECTED_RUN_MODE=victim
# VITE_PROTECTED_RUN_URL=/api/run
# VITE_PROTECTED_RUN_MODE=guarded

# Server-Sent Events stream for a run; {id} is replaced with the run id.
# VITE_STREAM_URL=/api/runs/{id}/stream

# Landing search router (one Gemini Decisions API question). Empty uses local rules only.
# VITE_ROUTER_URL=/api/route

# Health check behind the "temporarily unavailable" banner. Empty never shows it.
# VITE_HEALTH_URL=/health

# Development only: play the recorded runs in src/fixtures instead of calling the APIs.
# VITE_REPLAY_MODE=true
