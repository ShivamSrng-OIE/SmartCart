# Copy to .env.local and point the two AI shoppers at your APIs.
# Both default to the shared FastAPI route (/api/run) with a different `mode` field.

# Mode 2 · AI shopper (unprotected)
VITE_UNPROTECTED_RUN_URL=/api/run
VITE_UNPROTECTED_RUN_MODE=victim

# Mode 3 · AI shopper + CartTrap
VITE_PROTECTED_RUN_URL=/api/run
VITE_PROTECTED_RUN_MODE=guarded

# Server-Sent Events stream for a run; {id} is replaced with the run id
VITE_STREAM_URL=/api/runs/{id}/stream

# Landing search router: POST {text, question, choices[]} -> {choice, probabilities}
# Backed by the Gemini Decisions API (one `choice` question). Leave empty to use local rules only.
VITE_ROUTER_URL=/api/route
