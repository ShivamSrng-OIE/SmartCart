# Copy to backend/.env and fill in at least one provider key. Never commit the real file.

# Provider keys: OpenRouter (free models) is used when its key is set, Gemini otherwise.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Starting provider: openrouter or gemini (the AI models and keys page can switch it).
# LLM_PROVIDER=openrouter

# Seller portal: the operator account name and the sellers' shared password.
# Choose your own password for any public deployment.
MERCHANT_USERNAME=warehouse
MERCHANT_PASSWORD=

# Comma-separated origins allowed to call the API (the deployed frontend's address).
# CORS_ORIGINS=https://tote-store.pages.dev

# Shopify Shop MCP endpoint.
SHOP_MCP_URL=https://mcp.shop.com/

# Firewall: "decisions" uses the Gemini Decisions API, "json_llm" a single JSON question.
FIREWALL_BACKEND=decisions
# Deadlines in ms; past them the check fails closed (the order is held).
# FIREWALL_TIMEOUT_MS=2500
# OPENROUTER_FIREWALL_TIMEOUT_MS=45000

# Optional Gemini model overrides (OpenRouter's free model lists are fixed in app/llm/settings.py).
# MODEL_VICTIM=gemini-4-hydrogen
# MODEL_PERCEPTION=gemini-4-argon
# MODEL_FIREWALL=gemini-decision-1
# MODEL_DEFENDER=gemini-4-neon
# MODEL_REDTEAM=gemini-4-carbon
# MODEL_IMAGEGEN=gemini-nano-banana-2.1
